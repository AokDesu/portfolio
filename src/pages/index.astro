---
import SiteLayout from '../layouts/SiteLayout.astro';
import Folders from '../components/Folders.astro';
import Exhibit from '../components/Exhibit.astro';
import { PROJECTS } from '../data/projects';
---
<SiteLayout title="Aekarut Phetpradit — Portfolio">
  <section class="intro" aria-labelledby="name">
    <div class="intro-text" data-rise>
      <h1 id="name">Aekarut<br />Phetpradit</h1>
      <p class="role">KMUTT student · Software Developer</p>
      <p class="intro-line">Mobile experiences, systems from first principles, and the tools in between.</p>
    </div>
    <nav class="intro-index" aria-label="All projects">
      <Folders />
    </nav>
  </section>

  <div class="collection" id="work">
    {PROJECTS.map((project, order) => (
      <>
        <span class="anchor" id={project.slug}></span>
        <section
          class="chapter field"
          style={`--c:${project.color};--on:${project.ink}`}
          data-vt-field={project.slug}
          aria-labelledby={`title-${project.slug}`}
        >
          <div class="chapter-text" data-rise>
            <h2 id={`title-${project.slug}`} class:list={{ long: project.title.length > 18 }} data-vt-title>{project.title}</h2>
            <p class="lead">{project.lead}</p>
            <p class="meta">{project.categoryLabel} · {project.roleNote}</p>
            <p class="stack">{project.stack.slice(0, 5).join(', ')}</p>
            <a class="btn" href={`/projects/${project.slug}/`}>Open project<span class="sr-only">: {project.title}</span> <svg viewBox="0 0 24 16" aria-hidden="true"><path d="M0 8h22M15 1l7 7-7 7" /></svg></a>
          </div>
          <div class="chapter-art" data-rise>
            <Exhibit
              kind={project.images[project.cover[0]].kind}
              eager={order === 0}
              captions={false}
              items={project.cover.map(index => ({ path: project.images[index].srcPath, caption: project.images[index].caption, alt: project.images[index].alt }))}
            />
          </div>
        </section>
      </>
    ))}
  </div>
</SiteLayout>
<style>
  .intro { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--gap); align-items: end; min-height: min(calc(100svh - 72px), 780px); padding: clamp(24px, 5vh, 64px) var(--m) clamp(48px, 8vh, 96px); }
  h1 { font: var(--display); font-stretch: 68%; letter-spacing: -0.02em; }
  .role { margin-top: 30px; font: var(--lead); font-weight: 650; }
  .intro-line { margin-top: 10px; font: var(--lead); max-width: 30ch; }

  .anchor { display: block; height: 0; }
  .chapter { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--gap); align-items: center; min-height: 100svh; padding: clamp(56px, 9vh, 112px) var(--m); }
  .chapter h2 { font: var(--head); font-stretch: 70%; letter-spacing: -0.015em; }
  .chapter h2.long { font-size: clamp(40px, 4.4vw, 68px); }
  .lead { margin-top: 22px; font: var(--lead); max-width: 26ch; }
  .meta { margin-top: 26px; max-width: 46ch; }
  .stack { margin-top: 10px; max-width: 46ch; }
  .btn { margin-top: 34px; }
  .chapter-art { min-width: 0; }
  .chapter-art :global(.exhibit-window), .chapter-art :global(.exhibit-browser), .chapter-art :global(.exhibit-paper) { max-height: 72svh; }

  /* The signature: on screens big enough to hold a whole chapter, each one pins and the
     next slides over it. Elsewhere, when a chapter is taller than the window, and with
     reduced motion, they simply follow each other. */
  @media (min-width: 900px) and (min-height: 640px) and (prefers-reduced-motion: no-preference) {
    .chapter { position: sticky; top: 0; }
    .chapter.loose { position: relative; }
  }

  @media (max-width: 899px) {
    .intro { grid-template-columns: 1fr; min-height: 0; align-items: start; padding-bottom: 56px; }
    h1 { font-size: clamp(56px, 22vw, 120px); }
    .role { margin-top: 20px; }
    .chapter { grid-template-columns: 1fr; min-height: 0; padding: 56px var(--m) 64px; }
    .chapter h2 { font-size: clamp(44px, 14vw, 72px); }
    .chapter h2.long { font-size: clamp(36px, 10.5vw, 56px); }
  }
</style>
