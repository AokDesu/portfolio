---
import GalleryLayout from '../../layouts/GalleryLayout.astro';
import GalleryWorld from '../../components/GalleryWorld.astro';
import Exhibit from '../../components/Exhibit.astro';
import { PROJECTS } from '../../data/projects';
import { getProjectImage } from '../../utils/images';

const index = PROJECTS.findIndex(project => project.slug === 'droneaid');
const project = PROJECTS[index];
const next = PROJECTS[index + 1];
const [login, request, tracking, adminMap, architecture] = project.images;
const architectureImage = getProjectImage(architecture.srcPath)!;
const stations = [
  { id: 'droneaid', title: 'DroneAid' },
  { id: 'two-roles', title: 'Two roles, one system' },
  { id: 'architecture', title: 'Behind the interface' },
];
---
<GalleryLayout title="DroneAid — Aekarut Phetpradit" description={project.summary}>
  <article data-category={project.category}>
    <div class="collection" data-track>
      <div class="stage" data-stage>
        <GalleryWorld />
        <header class="station" id="droneaid" data-station data-title="DroneAid">
          <div class="station-inner">
            <div class="station-label">
              <a class="back" href="/#droneaid"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M15 8H1M6 3 1 8l5 5" /></svg> All projects</a>
              <p class="category-line">{project.categoryLabel} · Team work</p>
              <h1>DroneAid</h1>
              <p class="lead">Relief supplies, from request to arrival.</p>
              <p class="copy">A drone delivery simulator connecting civilians, relief coordinators and a serverless Firebase backend.</p>
              <p class="role-note">Five-person team. Aekarut: team lead, backend and integration.</p>
              <a class="text-link" href="#overview">Project facts <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1v13M3 9l5 5 5-5" /></svg></a>
            </div>
            <div class="station-art">
              <Exhibit kind="phone" eager scene items={[
                { path: request.srcPath, caption: request.caption },
                { path: tracking.srcPath, caption: tracking.caption },
              ]} />
            </div>
          </div>
        </header>
        <section class="station" id="two-roles" data-station data-title="Two roles, one system" aria-labelledby="roles-title">
          <div class="station-inner">
            <div class="station-label">
              <h2 id="roles-title">Two roles, one system.</h2>
              <p class="copy">Civilians sign in to request supplies and follow their delivery. Relief coordinators approve requests and watch the fleet on a live map. Role-aware routing sends each account to its own side of the app.</p>
            </div>
            <div class="station-art">
              <Exhibit kind="phone" scene items={[
                { path: login.srcPath, caption: login.caption },
                { path: adminMap.srcPath, caption: adminMap.caption },
              ]} />
            </div>
          </div>
        </section>
        <section class="station" id="architecture" data-station data-title="Behind the interface" aria-labelledby="architecture-title">
          <div class="station-inner">
            <div class="station-label">
              <h2 id="architecture-title">Behind the interface.</h2>
              <p class="copy">Firestore events and Cloud Functions coordinate requests, dispatch and simulated telemetry. Firebase Cloud Messaging carries notifications; map tiles come from OpenStreetMap.</p>
              <a class="text-link" href={architectureImage.src}>Open the full-size diagram <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
            </div>
            <div class="station-art">
              <Exhibit kind="paper" scene items={[{
                path: architecture.srcPath,
                caption: architecture.caption,
                alt: 'DroneAid C4 context: civilians submit requests and track drones; coordinators approve and dispatch; Firebase Cloud Messaging sends notifications and OpenStreetMap provides tiles.',
              }]} />
            </div>
          </div>
        </section>
        <nav class="rail" data-rail aria-label="DroneAid exhibits">
          <span>DroneAid · <span class="rail-current" data-rail-current>DroneAid</span></span>
          <ol>
            {stations.map((station, order) => (
              <li><a href={`#${station.id}`} data-rail-index={order} aria-current={order === 0 ? 'step' : undefined}><span class="sr-only">{station.title}</span></a></li>
            ))}
          </ol>
        </nav>
      </div>
    </div>

    <section class="project-facts" id="overview" aria-labelledby="overview-title">
      <div class="facts-intro">
        <h2 id="overview-title">A delivery system, not just a screen.</h2>
        <p>{project.description}</p>
      </div>
      <dl class="facts-list">
        <div><dt>Context</dt><dd>{project.teamLabel}</dd></div>
        <div><dt>Built with</dt><dd>{project.stack.join(', ')}</dd></div>
        <div><dt>My contribution</dt><dd>{project.teamCredit}</dd></div>
        <div><dt>Screens</dt><dd>Design-prototype captures from the project's UI design specification, cropped to the app; not a running-app demonstration.</dd></div>
        <div><dt>Source</dt><dd><a class="source" href={project.repoUrl!} target="_blank" rel="noopener noreferrer">AokDesu/CSC291-DroneAid <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" /></svg></a></dd></div>
      </dl>
    </section>
    {next && (
      <nav class="next-project" aria-label="Next project">
        <span>Next in the collection</span>
        <a href={`/projects/${next.slug}/`}>{next.title} <svg viewBox="0 0 24 16" aria-hidden="true"><path d="M0 8h22M15 1l7 7-7 7" /></svg></a>
      </nav>
    )}
  </article>
</GalleryLayout>
<style>
  .station-inner { min-height:100svh; padding:120px var(--margin) 96px; display:grid; grid-template-columns:5fr 6fr; column-gap:6vw; align-items:center; position:relative; }
  :global(html[data-world='active']) .station-inner { min-height:0; height:100%; }
  .station-label { max-width:520px; position:relative; z-index:2; }
  .station + .station { border-top:1px solid var(--line); }
  :global(html[data-world='active']) .station { border-top:0; }
  .station-art { position:relative; min-width:0; z-index:1; display:flex; justify-content:center; }
  .back { display:inline-flex; align-items:center; gap:12px; color:var(--muted); min-height:44px; margin-bottom:22px; font-size:14px; }
  .back:hover { color:var(--ink); }
  h1 { font-size:clamp(64px,7vw,104px); line-height:.98; letter-spacing:-.035em; margin-block:16px 26px; }
  h2 { font-size:clamp(36px,4.2vw,60px); letter-spacing:-.03em; margin-bottom:24px; }
  .lead { font-size:clamp(22px,2.2vw,32px); line-height:1.3; max-width:20ch; margin-bottom:18px; }
  .copy { font-size:18px; line-height:1.65; color:var(--muted); max-width:42ch; margin-bottom:24px; }
  .role-note { font-size:14px; color:var(--ink); margin-bottom:20px; }
  .project-facts { position:relative; z-index:3; background:var(--stage); padding:112px var(--margin); display:grid; grid-template-columns:5fr 6fr; column-gap:6vw; border-top:1px solid var(--line); }
  .facts-intro p { font-size:17px; color:var(--muted); max-width:55ch; }
  .facts-list > div { display:grid; grid-template-columns:140px 1fr; gap:24px; border-bottom:1px solid var(--line); padding:22px 0; }
  .facts-list > div:first-child { padding-top:0; }
  dt { font-size:14px; color:var(--muted); }
  dd { font-size:15px; line-height:1.7; overflow-wrap:anywhere; }
  .source { text-decoration:underline; text-underline-offset:5px; }
  .next-project { position:relative; z-index:3; background:var(--stage); padding:56px var(--margin) 80px; border-top:1px solid var(--line); }
  .next-project > span { color:var(--muted); font-size:14px; }
  .next-project > a { display:flex; align-items:center; justify-content:space-between; gap:24px; font-size:clamp(36px,5vw,72px); margin-top:16px; line-height:1.2; }
  .next-project svg { width:48px; height:32px; transition:transform 300ms var(--ease); }
  .next-project > a:hover svg { transform:translateX(8px); }
  @media(max-width:899px) {
    .station-inner { min-height:0; grid-template-columns:1fr; row-gap:36px; padding-block:56px 72px; }
    header .station-inner { padding-top:100px; }
    h1 { font-size:clamp(56px,15vw,80px); }
    h2 { font-size:clamp(32px,8vw,44px); }
    .copy { font-size:16px; }
    .project-facts { grid-template-columns:1fr; row-gap:40px; padding-block:64px; }
    .facts-list > div { grid-template-columns:1fr; gap:6px; }
    .next-project { padding-block:40px 56px; }
  }
</style>
