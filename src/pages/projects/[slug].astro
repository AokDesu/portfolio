---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Exhibit from '../../components/Exhibit.astro';
import { PROJECTS, hasLongTitle, type Project } from '../../data/projects';

export function getStaticPaths() {
  return PROJECTS.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: PROJECTS[(index + 1) % PROJECTS.length] },
  }));
}

interface Props { project: Project; next: Project }
const { project, next } = Astro.props;

const items = (indices: number[]) => indices.map(index => ({
  path: project.images[index].srcPath,
  caption: project.images[index].caption,
  alt: project.images[index].alt,
}));
const kindOf = (indices: number[]) => project.images[indices[0]].kind;
const field = `--c:${project.color};--on:${project.ink}`;
const ext = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" /></svg>';
---
<SiteLayout title={`${project.title} — Aekarut Phetpradit`} description={project.summary} field={{ color: project.color, ink: project.ink }}>
  <article>
    <header class="hero field vt-field" style={field}>
      <div class="hero-text">
        <h1 class:list={['vt-title', { long: hasLongTitle(project) }]}>{project.title}</h1>
        <p class="lead">{project.lead}</p>
        <p class="meta">{project.categoryLabel} · {project.roleNote}</p>
        <div class="actions">
          {project.repoUrl
            ? <a class="btn" href={project.repoUrl} target="_blank" rel="noopener noreferrer">{project.prLinks ? 'Repository' : 'Source on GitHub'} <Fragment set:html={ext} /></a>
            : <p class="private">Private repository</p>}
          {project.prLinks?.map(pr => (
            <a class="btn ghost" href={pr.url} target="_blank" rel="noopener noreferrer">{pr.title} · {pr.status === 'merged' ? 'Merged' : 'Open'} <Fragment set:html={ext} /></a>
          ))}
        </div>
        <a class="back" href={`/#${project.slug}`}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M15 8H1M6 3 1 8l5 5" /></svg> All projects</a>
      </div>
      <div class="hero-art">
        <Exhibit kind={kindOf(project.cover)} eager items={items(project.cover)} />
      </div>
    </header>

    {project.stations.map((station, order) => (
      <>
        <span class="anchor" id={station.id}></span>
        <section
          class:list={['chapter', 'station', (project.stations.length - 1 - order) % 2 === 0 ? 'deep' : 'paper', { flip: order % 2 === 1 }]}
          style={field}
          aria-labelledby={`${station.id}-title`}
        >
          <div class="station-text" data-rise>
            <h2 id={`${station.id}-title`} class:list={{ long: station.title.length > 24, xlong: station.title.length > 36 }}>{station.title}</h2>
            <p>{station.copy}</p>
          </div>
          <div class="station-art" data-rise>
            <Exhibit kind={kindOf(station.images)} items={items(station.images)} />
          </div>
        </section>
      </>
    ))}

    <section class="facts" id="overview" aria-labelledby="overview-title">
      <div class="facts-intro" data-rise>
        <h2 id="overview-title">About the project</h2>
        <p>{project.description}</p>
      </div>
      <dl class="facts-list">
        <div><dt>Context</dt><dd>{project.teamLabel}</dd></div>
        <div><dt>Built with</dt><dd>{project.stack.join(', ')}</dd></div>
        <div><dt>{project.teamType === 'team' ? 'My contribution' : 'Authorship'}</dt><dd>{project.teamCredit}</dd></div>
        <div><dt>Images</dt><dd>{project.evidence}</dd></div>
        {project.imageCredits && <div><dt>Image credits</dt><dd>{project.imageCredits}</dd></div>}
        {project.prLinks && (
          <div><dt>Pull requests</dt><dd class="links">
            {project.prLinks.map(pr => (
              <a href={pr.url} target="_blank" rel="noopener noreferrer">{pr.title} · {pr.status === 'merged' ? 'Merged' : 'Open'} <Fragment set:html={ext} /></a>
            ))}
          </dd></div>
        )}
        <div><dt>Source</dt><dd>
          {project.repoUrl
            ? <a href={project.repoUrl} target="_blank" rel="noopener noreferrer">{project.repoUrl.replace('https://github.com/', '')} <Fragment set:html={ext} /></a>
            : <span>Private repository</span>}
        </dd></div>
      </dl>
    </section>

    <nav class="next-band" aria-label="Next project">
      <a class="next field" href={`/projects/${next.slug}/`} style={`--c:${next.color};--on:${next.ink}`} data-vt-field={next.slug}>
        <span class="next-label">Next project</span>
        <span class="next-title" data-vt-title>{next.title}</span>
        <svg viewBox="0 0 24 16" aria-hidden="true"><path d="M0 8h22M15 1l7 7-7 7" /></svg>
      </a>
    </nav>
  </article>
</SiteLayout>
<style>
  .vt-field { view-transition-name: field; }
  .vt-title { view-transition-name: title; }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--gap); align-items: center; min-height: calc(100svh - 72px); padding: clamp(24px, 5vh, 72px) var(--m) clamp(56px, 9vh, 112px); }
  .back { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-top: 22px; font: var(--small); font-size: 16px; text-decoration: none; }
  .back:hover { text-decoration: underline; text-underline-offset: 4px; }
  h1 { font: var(--display); font-size: clamp(64px, 9.4vw, 160px); font-stretch: 66%; letter-spacing: -0.02em; overflow-wrap: anywhere; }
  h1.long { font-size: clamp(52px, 6.6vw, 112px); }
  .lead { margin-top: 26px; font: var(--lead); max-width: 28ch; }
  .meta { margin-top: 22px; max-width: 46ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; align-items: center; }
  .btn.ghost { background: transparent; color: var(--on); border: 2px solid var(--on); }
  .private { font: var(--lead); font-weight: 650; }
  .hero-art { min-width: 0; --art-max-h: 66svh; }

  .anchor { display: block; height: 0; }
  .station { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: var(--gap); align-items: center; min-height: 100svh; padding: clamp(64px, 10vh, 120px) var(--m); }
  .station.deep { background: color-mix(in oklab, var(--c) 34%, #0b0c0b); color: #fff; }
  .station.flip { grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); }
  .station.flip .station-text { order: 2; }
  .station.paper { background: var(--paper); color: var(--ink); }
  .station h2 { font: var(--head); font-size: clamp(40px, 4.6vw, 76px); font-stretch: 72%; letter-spacing: -0.01em; }
  .station h2.long { font-size: clamp(32px, 3.4vw, 56px); }
  .station h2.xlong { font-size: clamp(28px, 2.7vw, 44px); }
  .station-text p { margin-top: 20px; max-width: 42ch; }
  .station-art { min-width: 0; --art-max-h: 70svh; }
  .station-art :global(.exhibit-phone) { justify-content: center; }

  .facts { position: relative; z-index: 2; background: var(--paper); display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--gap); padding: clamp(80px, 12vw, 160px) var(--m); }
  .facts h2 { font: var(--head); font-size: clamp(40px, 4.6vw, 76px); font-stretch: 72%; }
  .facts-intro p { margin-top: 24px; max-width: 60ch; }
  .facts-list { display: grid; gap: 26px; align-content: start; }
  dt { font: 700 15px/1.3 'Archivo Variable', sans-serif; }
  dd { margin-top: 4px; overflow-wrap: anywhere; }
  dd a { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; text-underline-offset: 4px; }
  .links { display: grid; justify-items: start; }

  .next-band { position: relative; z-index: 2; }
  .next { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'label label' 'title arrow'; align-items: end; gap: 10px 24px; padding: clamp(56px, 8vw, 96px) var(--m); text-decoration: none; }
  .next-label { grid-area: label; font: var(--lead); }
  .next-title { grid-area: title; font: var(--head); font-size: clamp(40px, 5.6vw, 92px); font-stretch: 70%; }
  .next svg { grid-area: arrow; width: 56px; height: 40px; stroke-width: 1.4; }
  .next:hover .next-title { text-decoration: underline; text-underline-offset: 8px; text-decoration-thickness: 3px; }
  @media (prefers-reduced-motion: no-preference) {
    .next svg { transition: transform 360ms var(--out); }
    .next:hover svg { transform: translateX(10px); }
  }

  /* Stations pin and slide over each other like the home chapters, when they fit. */
  @media (min-width: 900px) and (min-height: 640px) and (prefers-reduced-motion: no-preference) {
    .station { position: sticky; top: 0; }
    .station.loose { position: relative; }
  }

  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; min-height: 0; padding-top: 12px; }
    h1 { font-size: clamp(56px, 19vw, 104px); }
    h1.long { font-size: clamp(40px, 11vw, 72px); }
    .station h2.long { font-size: clamp(30px, 8.6vw, 44px); }
    .station h2.xlong { font-size: clamp(24px, 7vw, 36px); }
    .station { grid-template-columns: 1fr; min-height: 0; padding: 64px var(--m); }
    .station.flip .station-text { order: 0; }
    .facts { grid-template-columns: 1fr; padding-block: 72px; }
    .next svg { width: 40px; height: 28px; }
  }
</style>
