---
import GalleryLayout from '../../layouts/GalleryLayout.astro';
import GalleryWorld from '../../components/GalleryWorld.astro';
import Exhibit from '../../components/Exhibit.astro';
import { PROJECTS, type Project } from '../../data/projects';

export function getStaticPaths() {
  return PROJECTS.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: PROJECTS[(index + 1) % PROJECTS.length] },
  }));
}

interface Props { project: Project; next: Project }
const { project, next } = Astro.props;

const items = (indices: number[]) => indices.map(index => {
  const image = project.images[index];
  return { path: image.srcPath, caption: image.caption, alt: image.alt };
});
const kindOf = (indices: number[]) => project.images[indices[0]].kind;
const stations = [
  { id: project.slug, title: project.title },
  ...project.stations.map(station => ({ id: station.id, title: `${project.title} · ${station.title.replace(/\.$/, '')}` })),
];
const ext = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" /></svg>';
---
<GalleryLayout title={`${project.title} — Aekarut Phetpradit`} description={project.summary}>
  <article data-category={project.category}>
    <div class="collection" data-track>
      <div class="stage" data-stage>
        <GalleryWorld />
        <header class="station" id={project.slug} data-station data-title={stations[0].title}>
          <div class="station-inner">
            <div class="station-label">
              <a class="back" href={`/#${project.slug}`}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M15 8H1M6 3 1 8l5 5" /></svg> All projects</a>
              <p class="category-line">{project.categoryLabel} · {project.teamType === 'team' ? 'Team work' : 'Individual contribution'}</p>
              <h1 class:list={{ long: project.title.length > 16 }}>{project.title}</h1>
              <p class="lead">{project.lead}</p>
              <p class="copy">{project.summary}</p>
              <p class="role-note">{project.roleNote}</p>
              <a class="text-link" href="#overview">Project facts <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1v13M3 9l5 5 5-5" /></svg></a>
            </div>
            <div class="station-art">
              <Exhibit kind={kindOf(project.cover)} eager scene items={items(project.cover)} />
            </div>
          </div>
        </header>
        {project.stations.map((station, order) => (
          <section class="station" id={station.id} data-station data-title={stations[order + 1].title} aria-labelledby={`${station.id}-title`}>
            <div class="station-inner">
              <div class="station-label">
                <h2 id={`${station.id}-title`}>{station.title}</h2>
                <p class="copy">{station.copy}</p>
              </div>
              <div class="station-art">
                <Exhibit kind={kindOf(station.images)} scene items={items(station.images)} />
              </div>
            </div>
          </section>
        ))}
        <nav class="rail" data-rail aria-label={`${project.title} exhibits`}>
          <span class="rail-current" data-rail-current>{stations[0].title}</span>
          <ol>
            {stations.map((station, order) => (
              <li><a href={`#${station.id}`} data-rail-index={order} aria-current={order === 0 ? 'step' : undefined}><span class="sr-only">{station.title}</span></a></li>
            ))}
          </ol>
        </nav>
      </div>
    </div>

    <section class="project-facts" id="overview" aria-labelledby="overview-title">
      <div class="facts-intro">
        <h2 id="overview-title">About the project</h2>
        <p>{project.description}</p>
      </div>
      <dl class="facts-list">
        <div><dt>Context</dt><dd>{project.teamLabel}</dd></div>
        <div><dt>Built with</dt><dd>{project.stack.join(', ')}</dd></div>
        <div><dt>{project.teamType === 'team' ? 'My contribution' : 'Authorship'}</dt><dd>{project.teamCredit}</dd></div>
        <div><dt>Images</dt><dd>{project.evidence}</dd></div>
        {project.imageCredits && <div><dt>Image credits</dt><dd>{project.imageCredits}</dd></div>}
        {project.prLinks && (
          <div><dt>Pull requests</dt><dd class="links">
            {project.prLinks.map(pr => (
              <a class="source" href={pr.url} target="_blank" rel="noopener noreferrer">{pr.title} · {pr.status === 'merged' ? 'Merged' : 'Open'} <Fragment set:html={ext} /></a>
            ))}
          </dd></div>
        )}
        <div><dt>Source</dt><dd>
          {project.repoUrl
            ? <a class="source" href={project.repoUrl} target="_blank" rel="noopener noreferrer">{project.repoUrl.replace('https://github.com/', '')} <Fragment set:html={ext} /></a>
            : <span>Private repository</span>}
        </dd></div>
      </dl>
    </section>
    <nav class="next-project" aria-label="Next project">
      <span>Next in the collection</span>
      <a href={`/projects/${next.slug}/`}>{next.title} <svg viewBox="0 0 24 16" aria-hidden="true"><path d="M0 8h22M15 1l7 7-7 7" /></svg></a>
    </nav>
  </article>
</GalleryLayout>
<style>
  .station-inner { min-height:100svh; padding:120px var(--margin) 96px; display:grid; grid-template-columns:5fr 6fr; column-gap:6vw; align-items:center; position:relative; }
  :global(html[data-world='active']) .station-inner { min-height:0; height:100%; padding-block:clamp(80px,12vh,120px) clamp(64px,10vh,96px); }
  :global(html[data-world='active']) .back { margin-bottom:min(22px,2.4vh); }
  :global(html[data-world='active']) h1 { font-size:min(clamp(52px,6.4vw,96px),8.5vh); margin-block:min(16px,2vh) min(26px,3vh); }
  :global(html[data-world='active']) h1.long { font-size:min(clamp(44px,4.6vw,72px),8.5vh); }
  :global(html[data-world='active']) h2 { font-size:min(clamp(34px,4vw,56px),6.5vh); margin-bottom:min(24px,3vh); }
  :global(html[data-world='active']) .lead { font-size:min(clamp(22px,2.2vw,32px),3.6vh); max-width:30ch; margin-bottom:min(18px,2.2vh); }
  :global(html[data-world='active']) .copy { font-size:min(18px,2.4vh); max-width:48ch; margin-bottom:min(24px,2.8vh); }
  :global(html[data-world='active']) .role-note { margin-bottom:min(20px,2.4vh); }
  .station-label { max-width:520px; position:relative; z-index:2; min-width:0; }
  .station + .station { border-top:1px solid var(--line); }
  :global(html[data-world='active']) .station { border-top:0; }
  .station-art { position:relative; min-width:0; z-index:1; display:flex; justify-content:center; }
  .back { display:inline-flex; align-items:center; gap:12px; color:var(--muted); min-height:44px; margin-bottom:22px; font-size:14px; }
  .back:hover { color:var(--ink); }
  h1 { font-size:clamp(52px,6.4vw,96px); line-height:.98; letter-spacing:-.035em; margin-block:16px 26px; overflow-wrap:break-word; }
  h1.long { font-size:clamp(44px,4.6vw,72px); }
  h2 { font-size:clamp(34px,4vw,56px); letter-spacing:-.03em; margin-bottom:24px; }
  .lead { font-size:clamp(22px,2.2vw,32px); line-height:1.3; max-width:22ch; margin-bottom:18px; }
  .copy { font-size:18px; line-height:1.65; color:var(--muted); max-width:42ch; margin-bottom:24px; }
  .role-note { font-size:14px; color:var(--ink); margin-bottom:20px; max-width:44ch; }
  .project-facts { position:relative; z-index:3; background:var(--stage); padding:112px var(--margin); display:grid; grid-template-columns:5fr 6fr; column-gap:6vw; border-top:1px solid var(--line); }
  .facts-intro p { font-size:17px; color:var(--muted); max-width:55ch; }
  .facts-list > div { display:grid; grid-template-columns:140px 1fr; gap:24px; border-bottom:1px solid var(--line); padding:22px 0; }
  .facts-list > div:first-child { padding-top:0; }
  dt { font-size:14px; color:var(--muted); }
  dd { font-size:15px; line-height:1.7; overflow-wrap:anywhere; }
  .links { display:grid; gap:4px; justify-items:start; }
  .source { text-decoration:underline; text-underline-offset:5px; }
  .source:hover { text-decoration-color:var(--accent); }
  .next-project { position:relative; z-index:3; background:var(--stage); padding:56px var(--margin) 80px; border-top:1px solid var(--line); }
  .next-project > span { color:var(--muted); font-size:14px; }
  .next-project > a { display:flex; align-items:center; justify-content:space-between; gap:24px; font-size:clamp(32px,5vw,72px); margin-top:16px; line-height:1.15; }
  .next-project svg { width:48px; height:32px; flex:none; transition:transform 300ms var(--ease); }
  .next-project > a:hover svg { transform:translateX(8px); }
  @media(max-width:899px) {
    .station-inner { min-height:0; grid-template-columns:1fr; row-gap:36px; padding-block:56px 72px; }
    header .station-inner { padding-top:100px; }
    h1 { font-size:clamp(40px,11vw,72px); }
    h2 { font-size:clamp(30px,7.5vw,44px); }
    .copy { font-size:16px; }
    .project-facts { grid-template-columns:1fr; row-gap:40px; padding-block:64px; }
    .facts-list > div { grid-template-columns:1fr; gap:6px; }
    .next-project { padding-block:40px 56px; }
    .next-project svg { width:36px; height:24px; }
  }
</style>
