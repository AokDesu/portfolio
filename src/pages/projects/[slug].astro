---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { PROJECTS, type Project, type ProjectImage } from '../../data/projects';
import { getProjectImage, isPhone, widthsFor } from '../../utils/images';

export function getStaticPaths() {
  return PROJECTS.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prevProject: index > 0 ? PROJECTS[index - 1] : null,
      nextProject: index < PROJECTS.length - 1 ? PROJECTS[index + 1] : null,
    },
  }));
}

interface Props {
  project: Project;
  prevProject: Project | null;
  nextProject: Project | null;
}

const { project, prevProject, nextProject } = Astro.props;

type Figure = ProjectImage & { meta?: ImageMetadata; file: string };
type Group = { kind: 'shelf' | 'wide'; figures: Figure[] };

// Consecutive phone screens share one shelf; every other capture gets its own wide plate.
const groups: Group[] = [];
for (const img of project.images) {
  const meta = getProjectImage(img.srcPath);
  const figure: Figure = { ...img, meta, file: img.srcPath.split('/').pop() ?? '' };
  const kind = meta && isPhone(meta) ? 'shelf' : 'wide';
  const last = groups.at(-1);
  if (kind === 'shelf' && last?.kind === 'shelf') last.figures.push(figure);
  else groups.push({ kind, figures: [figure] });
}
let firstImage = true;
const eager = () => {
  const value = firstImage;
  firstImage = false;
  return value ? 'eager' : 'lazy';
};
---

<Layout title={`${project.title} — Aekarut Phetpradit`} description={project.summary}>
  <article data-category={project.category}>
    <header class="poster" style={`view-transition-name: field-${project.slug}`}>
      <div class="grid poster-inner">
        <a href="/#work" class="back">
          <svg viewBox="0 0 16 12" aria-hidden="true"><path d="M16 6H2M7 1L2 6l5 5" /></svg>
          Back to all projects
        </a>
        <h1 class="title">{project.title}</h1>
        <p class="lead">{project.summary}</p>
      </div>
    </header>

    <section class="facts grid" aria-label="Project facts">
      <dl class="spec">
        <div><dt>Category</dt><dd><span class="swatch" aria-hidden="true"></span>{project.categoryLabel}</dd></div>
        <div><dt>Credit</dt><dd>{project.teamLabel}</dd></div>
        <div><dt>Stack</dt><dd>{project.stack.join(', ')}</dd></div>
        {project.repoUrl && (
          <div>
            <dt>Source</dt>
            <dd>
              <a href={project.repoUrl} target="_blank" rel="noopener noreferrer">
                {project.repoUrl.replace('https://', '')}<svg class="ext" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 2.5h6v6M9.5 2.5l-7 7" /></svg>
              </a>
            </dd>
          </div>
        )}
        {project.prLinks && (
          <div>
            <dt>Pull requests</dt>
            <dd class="prs">
              {project.prLinks.map((pr) => (
                <a href={pr.url} target="_blank" rel="noopener noreferrer">
                  {pr.status === 'merged' ? 'Merged' : 'Open'} · {pr.title.replace(/\s*\((Merged|Open)\)$/, '')}<svg class="ext" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 2.5h6v6M9.5 2.5l-7 7" /></svg>
                </a>
              ))}
            </dd>
          </div>
        )}
      </dl>

      <div class="prose">
        <h2>Overview</h2>
        <p>{project.description}</p>
        <h2>Team &amp; Authorship</h2>
        <p>{project.teamCredit}</p>
      </div>
    </section>

    <section class="gallery" aria-labelledby="gallery-title">
      <h2 class="gallery-title grid" id="gallery-title"><span>Visual Evidence &amp; Artifacts</span></h2>

      {groups.map((group) =>
        group.kind === 'shelf' ? (
          <div class="shelf" style={`--n:${group.figures.length}`}>
            {group.figures.map((fig) => (
              <figure class="shelf-fig">
                <div class="plate">
                  {fig.meta && (
                    <Image
                      src={fig.meta}
                      alt={fig.caption}
                      widths={widthsFor(fig.meta, [360, 520])}
                      sizes="(max-width: 760px) 44vw, 22vw"
                      loading={eager()}
                    />
                  )}
                </div>
                <figcaption>
                  <span>{fig.caption}</span>
                  <code>{fig.file}</code>
                </figcaption>
              </figure>
            ))}
          </div>
        ) : (
          group.figures.map((fig) => (
            <figure class="wide grid">
              <figcaption>
                <span>{fig.caption}</span>
                <code>{fig.file}</code>
              </figcaption>
              <div class="plate">
                {fig.meta ? (
                  <a href={fig.meta.src} class="zoom">
                    <Image
                      src={fig.meta}
                      alt={fig.caption}
                      widths={widthsFor(fig.meta, [720, 1080, 1600, 2000])}
                      sizes="(max-width: 760px) 92vw, 72vw"
                      loading={eager()}
                    />
                  </a>
                ) : (
                  <p class="missing">{fig.file}</p>
                )}
              </div>
            </figure>
          ))
        )
      )}
    </section>

    <nav class="pager" aria-label="Project pagination">
      {prevProject ? (
        <a href={`/projects/${prevProject.slug}`} class="page prev" data-category={prevProject.category} aria-label={`Previous project: ${prevProject.title}`}>
          <svg class="arrow" viewBox="0 0 16 12" aria-hidden="true"><path d="M16 6H2M7 1L2 6l5 5" /></svg>
          <span class="page-title">{prevProject.title}</span>
        </a>
      ) : <span class="page empty" />}
      {nextProject ? (
        <a href={`/projects/${nextProject.slug}`} class="page next" data-category={nextProject.category} aria-label={`Next project: ${nextProject.title}`}>
          <svg class="arrow" viewBox="0 0 16 12" aria-hidden="true"><path d="M0 6h14M9 1l5 5-5 5" /></svg>
          <span class="page-title">{nextProject.title}</span>
        </a>
      ) : <span class="page empty" />}
    </nav>
  </article>
</Layout>

<style>
  .poster {
    background: var(--c);
    color: var(--on);
  }

  .poster-inner {
    padding-block: 22px clamp(36px, 4.4vw, 64px);
    row-gap: 18px;
  }

  .back {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: clamp(48px, 9vw, 140px);
  }

  .back svg {
    width: 16px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: transform 320ms var(--ease);
  }

  .back:hover svg { transform: translateX(-5px); }

  .title {
    grid-column: 1 / span 10;
    font-size: clamp(2.75rem, 7vw, 6rem);
    font-weight: 820;
    font-stretch: 86%;
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .lead {
    grid-column: 1 / span 7;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    font-weight: 480;
    max-width: 60ch;
  }

  .facts {
    padding-block: clamp(40px, 5vw, 72px);
    row-gap: 40px;
    align-items: start;
  }

  .spec {
    grid-column: 1 / span 4;
    border-top: 2px solid var(--rule);
  }

  .spec div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 12px;
    padding-block: 11px;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .spec dt { font-weight: 650; }
  .spec dd { color: var(--ink-soft); overflow-wrap: anywhere; }

  .spec a {
    color: var(--ink);
    font-weight: 560;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .spec a:hover { text-decoration-thickness: 2px; }

  .swatch {
    display: inline-block;
    width: 0.75em;
    height: 0.75em;
    margin-right: 0.5em;
    background: var(--c);
    vertical-align: -0.04em;
  }

  .prs {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }


  .prose {
    grid-column: 6 / -1;
    max-width: 68ch;
  }

  .prose h2 {
    font-size: 1.0625rem;
    font-weight: 720;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .prose p {
    font-size: 1.0625rem;
    line-height: 1.62;
  }

  .prose p + h2 { margin-top: 36px; }

  .gallery-title {
    padding-block: 14px;
    border-top: 2px solid var(--rule);
    margin-inline: var(--margin);
    padding-inline: 0;
    font-size: 1.0625rem;
    font-weight: 720;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .gallery-title span { grid-column: 1 / -1; }

  .shelf {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin-inline: var(--margin);
    margin-bottom: clamp(48px, 6vw, 96px);
  }

  .shelf-fig {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
  }

  .shelf-fig .plate {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background: var(--c);
    padding: clamp(20px, 3vw, 48px) clamp(10px, 1.6vw, 24px) 0;
  }

  .shelf-fig .plate :global(img) { width: min(100%, 290px); height: auto; }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .shelf-fig figcaption { padding: 14px clamp(10px, 1.6vw, 24px) 0 0; max-width: 34ch; }

  figcaption code {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .wide {
    padding-inline: 0;
    margin-inline: var(--margin);
    margin-bottom: clamp(48px, 6vw, 96px);
    row-gap: 14px;
  }

  .wide figcaption {
    grid-column: 1 / span 3;
    grid-row: 1;
    align-self: end;
    padding-bottom: 4px;
  }

  .wide .plate {
    grid-column: 4 / -1;
    grid-row: 1;
    background: var(--c);
    padding: clamp(16px, 3vw, 48px) clamp(16px, 3vw, 48px) 0;
  }

  .wide .plate :global(img) { max-width: 100%; height: auto; margin-inline: auto; }

  .missing { padding: 60px 0; color: var(--on); text-align: center; }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-top: clamp(32px, 4vw, 64px);
  }

  .page {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: clamp(140px, 16vw, 220px);
    justify-content: space-between;
    padding: 18px var(--margin) 22px;
    background: var(--c);
    color: var(--on);
  }

  .page.next { text-align: right; }
  .page.empty { background: transparent; }

  .arrow {
    width: clamp(22px, 2.4vw, 32px);
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .next .arrow { align-self: flex-end; }

  .zoom { display: block; cursor: zoom-in; }

  .page-title {
    font-size: clamp(1.5rem, 3vw, 2.75rem);
    font-weight: 780;
    font-stretch: 86%;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
    transition: transform 420ms var(--ease);
  }

  .prev:hover .page-title { transform: translateX(-6px); }
  .next:hover .page-title { transform: translateX(6px); }

  @media (max-width: 960px) {
    .title { grid-column: 1 / -1; }
    .lead { grid-column: 1 / -1; }
    .spec { grid-column: 1 / -1; }
    .prose { grid-column: 1 / -1; }
    .wide figcaption { grid-column: 1 / -1; grid-row: 2; }
    .wide .plate { grid-column: 1 / -1; }
  }

  @media (max-width: 760px) {
    .shelf { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .shelf-fig figcaption { padding-left: 2px; padding-bottom: 28px; }
    .spec div { grid-template-columns: 6.25rem 1fr; }
    .pager { grid-template-columns: 1fr; }
    .page.empty { display: none; }
    .page.next { text-align: left; }
    .next .arrow { align-self: flex-start; }
  }
</style>
