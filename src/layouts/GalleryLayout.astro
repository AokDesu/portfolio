---
import '@fontsource-variable/archivo/wdth.css';
import { PROJECTS, CATEGORIES } from '../data/projects';
interface Props { title: string; description?: string; home?: boolean }
const { title, description = 'Aekarut Phetpradit — KMUTT student · Software Developer. Explore mobile applications, data research, systems and open-source work.', home = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101211" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="gallery-nav">
      <a class="identity" href="/" aria-label="Aekarut Phetpradit — home">Aekarut Phetpradit<span>Portfolio</span></a>
      <nav aria-label="Site">
        <button class="view-toggle" type="button" hidden>Still view</button>
        <details class="project-index">
          <summary>Project index <span class="index-count">{PROJECTS.length}</span></summary>
          <div class="index-panel">
            <p class="index-intro">Go straight to the work.</p>
            <div class="index-filters" role="group" aria-label="Filter project index" hidden>
              {CATEGORIES.map((category) => <button type="button" data-filter={category.id} aria-pressed={category.id === 'all' ? 'true' : 'false'}>{category.label}</button>)}
            </div>
            <ul class="index-list">
              {PROJECTS.map(project => <li data-index-category={project.category}>
                <a href={`/projects/${project.slug}/`}><span>{project.title}</span><small>{project.categoryLabel} · {project.teamType === 'team' ? 'Team work' : 'Individual contribution'}</small></a>
              </li>)}
            </ul>
            <p class="sr-only" id="index-status" aria-live="polite"></p>
          </div>
        </details>
        <a class="github" href="https://github.com/AokDesu" target="_blank" rel="noopener noreferrer">GitHub <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="gallery-footer">
      <div><p class="footer-name">Aekarut Phetpradit</p><p>KMUTT student · Software Developer</p></div>
      <a href="https://github.com/AokDesu" target="_blank" rel="noopener noreferrer">github.com/AokDesu <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
      <p class="footer-note">{home ? 'End of the collection.' : 'More work in the project index.'} Built with Astro and Three.js. 3D models: <a href="https://poly.pizza/m/4DRZmTs3jq" target="_blank" rel="noopener noreferrer">Smartphone</a> by smallbigsquare and <a href="https://poly.pizza/m/PvSjEbz11k" target="_blank" rel="noopener noreferrer">Monitor</a> by CreativeTrio, both CC0 via Poly Pizza. Pokémon icons in the Rules Helper captures by Darius Dan – Flaticon.</p>
    </footer>
  </body>
</html>
<script>
  const index = document.querySelector<HTMLDetailsElement>('.project-index');
  document.querySelector('.index-filters')?.removeAttribute('hidden');
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && index?.open) {
      index.open = false;
      index.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', event => {
    if (index?.open && event.target instanceof Node && !index.contains(event.target)) index.open = false;
  });
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const entries = document.querySelectorAll<HTMLElement>('[data-index-category]');
  for (const button of filters) button.addEventListener('click', () => {
    let count = 0;
    for (const entry of entries) {
      entry.hidden = button.dataset.filter !== 'all' && entry.dataset.indexCategory !== button.dataset.filter;
      if (!entry.hidden) count++;
    }
    for (const item of filters) item.setAttribute('aria-pressed', String(item === button));
    const status = document.querySelector('#index-status');
    if (status) status.textContent = `${count} projects shown`;
  });
</script>
<style is:global>
  :root { --stage:#101211; --surface:#191d1b; --ink:#eeeae2; --muted:#aaa9a4; --line:#3c423e; --accent:#b9d9cd; --mobile:#9bd4c5; --data:#dcb997; --tools:#afc2db; --oss:#d6ce9a; --margin:clamp(20px,4.5vw,72px); --ease:cubic-bezier(.16,1,.3,1); --phone-w:min(calc(56vh * 344 / 660), calc((50vw - var(--margin) - 40px) / 2.12), 280px); --art-h:min(52vh, 540px); --pair-gap:40px; --caption-gap:22px; color-scheme:dark; }
  @view-transition { navigation:auto; }
  ::view-transition-old(root),::view-transition-new(root) { animation-duration:420ms; animation-timing-function:var(--ease); }
  *,*::before,*::after { box-sizing:border-box; }
  html { margin:0; background:var(--stage); color:var(--ink); font-family:'Archivo Variable','Helvetica Neue',Arial,sans-serif; font-weight:400; line-height:1.65; -webkit-font-smoothing:antialiased; scrollbar-color:var(--muted) var(--stage); scroll-padding-top:100px; }
  body { margin:0; }
  /* On main, not body: body overflow propagates to the viewport, and phones then widen the layout viewport to fit the exhibits' light pools. */
  main { display:block; overflow-x:clip; }
  h1,h2,h3,p,figure,dl,dd { margin:0; }
  h1,h2,h3 { font-weight:450; line-height:1.1; text-wrap:balance; }
  a { color:inherit; text-decoration:none; }
  button { font:inherit; color:inherit; cursor:pointer; }
  img { display:block; width:100%; height:auto; }
  svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.5; vertical-align:middle; }
  [hidden] { display:none!important; }
  ::selection { background:var(--accent); color:var(--stage); }
  :focus-visible { outline:2px solid var(--accent); outline-offset:6px; }
  [data-category='mobile-apps'] { --category:var(--mobile); }
  [data-category='ai-data'] { --category:var(--data); }
  [data-category='tools-systems'] { --category:var(--tools); }
  [data-category='open-source'] { --category:var(--oss); }
  .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  .skip { position:fixed; top:-100px; left:var(--margin); padding:12px 20px; background:var(--ink); color:var(--stage); z-index:30; }
  .skip:focus { top:12px; }
  .gallery-nav { position:fixed; inset:0 0 auto; z-index:20; display:flex; justify-content:space-between; gap:24px; align-items:center; padding:20px var(--margin); background:rgb(16 18 17 / .96); border-bottom:1px solid var(--line); transition:background-color 400ms var(--ease), border-color 400ms var(--ease); }
  html[data-world='active']:not([data-past-stage]) .gallery-nav { background:transparent; border-color:transparent; }
  .identity { font-size:15px; font-weight:500; line-height:1.4; }
  .identity span { display:block; color:var(--muted); font-size:12px; font-weight:400; }
  .gallery-nav nav { display:flex; align-items:center; gap:28px; font-size:14px; }
  .gallery-nav a,.gallery-nav summary,.view-toggle { min-height:44px; display:inline-flex; align-items:center; }
  .gallery-nav .identity { display:block; padding-block:3px; }
  .view-toggle { padding:0; background:none; border:0; color:var(--muted); }
  .view-toggle:hover,.github:hover { color:var(--ink); text-decoration:underline; text-underline-offset:5px; }
  .github { gap:8px; }
  .project-index summary { gap:12px; cursor:pointer; list-style:none; }
  .project-index summary::-webkit-details-marker { display:none; }
  .index-count { border:1px solid var(--line); min-width:25px; height:25px; text-align:center; font-size:12px; line-height:23px; border-radius:50%; }
  .project-index[open] .index-count { background:var(--ink); color:var(--stage); }
  .index-panel { position:absolute; right:var(--margin); top:calc(100% + 8px); width:min(620px,calc(100vw - var(--margin)*2)); max-height:calc(100svh - 120px); overflow:auto; background:var(--surface); padding:24px; box-shadow:0 24px 72px rgb(0 0 0 / .4); }
  .index-intro { font-size:24px; margin-bottom:16px; }
  .index-filters { display:flex; flex-wrap:wrap; gap:4px 16px; padding-bottom:12px; }
  .index-filters button { background:none; border:0; padding:10px 0; font-size:12px; color:var(--muted); min-height:44px; }
  .index-filters [aria-pressed='true'] { color:var(--ink); text-decoration:underline; text-underline-offset:6px; }
  .index-list { list-style:none; margin:0; padding:0; }
  .index-list li { border-top:1px solid var(--line); }
  .index-list a { display:flex; flex-direction:column; align-items:flex-start; padding:13px 0; gap:2px; }
  .index-list a:hover span { text-decoration:underline; text-underline-offset:4px; }
  .index-list small { font-size:12px; color:var(--muted); }
  .text-link { display:inline-flex; align-items:center; gap:24px; min-height:44px; border-bottom:1px solid var(--ink); padding-block:8px; font-size:15px; }
  .text-link svg { transition:transform 240ms var(--ease); }
  .text-link:hover svg { transform:translateX(5px); }
  .category-line { display:flex; align-items:center; gap:10px; color:var(--muted); font-size:14px; }
  .category-line::before { content:''; width:6px; height:6px; background:var(--category,var(--accent)); border-radius:50%; }
  .gallery-footer { position:relative; z-index:2; background:var(--stage); border-top:1px solid var(--line); display:grid; grid-template-columns:1fr auto; gap:32px; padding:64px var(--margin) 32px; color:var(--muted); font-size:14px; }
  .footer-name { color:var(--ink); font-size:28px; margin-bottom:8px; }
  .gallery-footer>a { color:var(--ink); align-self:center; min-height:44px; display:flex; align-items:center; gap:8px; }
  .footer-note { grid-column:1/-1; border-top:1px solid var(--line); padding-top:24px; font-size:12px; max-width:110ch; }
  .footer-note a { text-decoration:underline; text-underline-offset:3px; }
  .footer-note a:hover { color:var(--ink); }

  /* Pinned stage: only while the 3D gallery runs. Every station shares the viewport and the
     scene's camera decides which one is in front; without it the stations are normal flow. */
  html[data-world='active'] { --art-h:min(40vh, 420px); --phone-w:min(calc(54vh * 344 / 660), calc((50vw - var(--margin) - 40px) / 2.12), 270px); }
  html[data-world='active'] [data-stage] { position:sticky; top:0; height:100vh; overflow:clip; }
  html[data-world='active'] [data-station] { position:absolute; inset:0; z-index:1; will-change:opacity,transform; }
  html[data-world='active'] [data-station][data-current] { z-index:2; }
  .rail { display:none; }
  html[data-world='active'] .rail { position:absolute; z-index:3; inset:auto var(--margin) 28px; display:flex; align-items:center; justify-content:space-between; gap:24px; font-size:12px; color:var(--muted); pointer-events:none; }
  .rail-current { color:var(--ink); }
  .rail ol { display:flex; gap:4px; list-style:none; margin:0; padding:0; pointer-events:auto; }
  .rail a { display:flex; align-items:center; justify-content:center; width:28px; height:44px; }
  .rail a::before { content:''; width:24px; height:2px; background:var(--line); transform:scaleX(.75); transition:background-color 300ms var(--ease), transform 300ms var(--ease); }
  .rail a:hover::before { background:var(--muted); }
  .rail a[aria-current]::before { background:var(--category-current, var(--ink)); transform:none; }

  @media(max-width:899px) { :root { --phone-w:min(calc((100vw - 2 * var(--margin) - 16px) / 2.12), 210px); --pair-gap:16px; --caption-gap:14px; } .gallery-nav { padding-block:12px; gap:12px; } .gallery-nav nav { gap:16px; } .gallery-nav .github { display:none; } .gallery-footer { grid-template-columns:1fr; padding-block:40px 24px; } .footer-note { grid-column:auto; } }
  @media(max-width:360px) { :root { --margin:16px; } .identity { font-size:13px; } .gallery-nav nav { font-size:13px; } }
  @media(prefers-reduced-motion:reduce) { *,*::before,*::after { animation:none!important; transition:none!important; scroll-behavior:auto!important; } @view-transition { navigation:none; } }
</style>
