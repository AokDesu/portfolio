---
import { Image } from 'astro:assets';
import { getProjectImage, widthsFor } from '../utils/images';
import type { ExhibitKind } from '../data/projects';

interface Item { path: string; caption: string; alt: string }
interface Props {
  items: Item[];
  kind?: ExhibitKind;
  eager?: boolean;
  /** Captions carry provenance on project pages; the home chapters link there instead. */
  captions?: boolean;
}

const { items, kind = 'window', eager = false, captions = true } = Astro.props;
const resolved = items.map(item => {
  const image = getProjectImage(item.path);
  if (!image) throw new Error(`Exhibit: no image at ${item.path}`);
  return { ...item, image };
});
const sizes = kind === 'phone' ? '(max-width: 899px) 45vw, 250px' : '(max-width: 899px) 92vw, 56vw';
---
<div class:list={['exhibit', `exhibit-${kind}`, { pair: resolved.length > 1 }]}>
  {resolved.map(({ image, caption, alt }) => (
    <figure class="artifact">
      <div class:list={['frame', `frame-${kind}`]}>
        {kind === 'browser' && <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i></div>}
        <Image
          src={image}
          width={image.width}
          height={image.height}
          alt={alt}
          widths={widthsFor(image, kind === 'phone' ? [344, 390, 688, 780] : [688, 1000, 1440])}
          sizes={sizes}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
        />
      </div>
      {captions && (
        <figcaption>{caption}{kind !== 'phone' && <> <a href={image.src} target="_blank" rel="noopener">Open full size<span class="sr-only"> image</span></a></>}</figcaption>
      )}
    </figure>
  ))}
</div>
<style>
  .exhibit { display: flex; justify-content: center; align-items: flex-start; gap: var(--pair-gap); min-width: 0; }
  .artifact { min-width: 0; }
  .frame { overflow: hidden; }

  /* Every phone on a page is the same width; the screen keeps its own capture ratio. */
  .exhibit-phone .artifact { width: var(--phone-w); flex: none; }
  .frame-phone { padding: calc(var(--phone-w) * 0.03); border-radius: calc(var(--phone-w) * 0.13); background: #0d0f0d; }
  .frame-phone img { border-radius: calc(var(--phone-w) * 0.1); }

  .exhibit-window .artifact, .exhibit-browser .artifact, .exhibit-paper .artifact { width: 100%; }
  .frame-window { border-radius: 12px; }
  .frame-paper { border-radius: 4px; background: #fafafa; }
  .frame-browser { border-radius: 12px; background: #e6e8e5; }
  .browser-bar { height: 26px; padding-inline: 14px; display: flex; align-items: center; gap: 6px; }
  .browser-bar i { width: 8px; height: 8px; border-radius: 50%; background: #8b908a; }

  figcaption { margin-top: 14px; font: var(--small); max-width: 60ch; text-wrap: pretty; }
  .exhibit-phone figcaption { width: var(--phone-w); }
  figcaption a { text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
</style>
