---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { getProjectImage } from '../utils/images';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const coverMetadata = getProjectImage(project.coverImage);
---

<article class="project-card" data-category={project.category}>
  <a href={`/projects/${project.slug}`} class="card-link" aria-label={`View ${project.title} project details`}>
    <div class="image-container">
      {coverMetadata ? (
        <Image 
          src={coverMetadata} 
          alt={`Screenshot preview of ${project.title}`}
          width={720}
          height={420}
          class="card-img"
          loading="lazy"
        />
      ) : (
        <div class="image-fallback">
          <span>{project.title}</span>
        </div>
      )}
      <div class="card-badges">
        <span class="badge category-badge">{project.categoryLabel}</span>
        <span class={`badge team-badge ${project.teamType === 'team' ? 'badge-team' : 'badge-solo'}`}>
          {project.teamType === 'team' ? 'Team Work' : 'Solo'}
        </span>
      </div>
    </div>

    <div class="card-body">
      <h3 class="card-title">{project.title}</h3>
      <p class="card-summary">{project.summary}</p>

      <div class="stack-list">
        {project.stack.slice(0, 5).map((tech) => (
          <span class="tech-tag">{tech}</span>
        ))}
        {project.stack.length > 5 && (
          <span class="tech-tag tag-more">+{project.stack.length - 5}</span>
        )}
      </div>

      <div class="card-footer">
        <span class="view-link">
          View details
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .project-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
  }

  .image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #0b0d13;
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.3s ease;
  }

  .project-card:hover .card-img {
    transform: scale(1.02);
  }

  .image-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-tertiary);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .card-badges {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .category-badge {
    background-color: rgba(9, 10, 15, 0.85);
    color: var(--text-primary);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .team-badge {
    border: 1px solid transparent;
  }

  .badge-team {
    background-color: rgba(59, 130, 246, 0.2);
    color: #93c5fd;
    border-color: rgba(59, 130, 246, 0.3);
  }

  .badge-solo {
    background-color: rgba(16, 185, 129, 0.2);
    color: #6ee7b7;
    border-color: rgba(16, 185, 129, 0.3);
  }

  .card-body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .card-summary {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 18px;
    flex: 1;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .tech-tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--text-secondary);
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    padding: 3px 7px;
    border-radius: var(--radius-sm);
  }

  .tag-more {
    color: var(--text-tertiary);
  }

  .card-footer {
    display: flex;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    padding-top: 14px;
  }

  .view-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    transition: gap 0.15s ease, color 0.15s ease;
  }

  .project-card:hover .view-link {
    gap: 10px;
    color: var(--accent-hover);
  }
</style>
